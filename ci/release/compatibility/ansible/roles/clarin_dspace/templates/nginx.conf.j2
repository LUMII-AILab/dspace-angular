# Runtime HTTPS ingress. No Docker socket, caching, or content mounts.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
    # Omit URLs, query strings, cookies, and authorization from access logs.
    log_format minimal '$time_iso8601 $request_method $status $body_bytes_sent $request_time';
    access_log /dev/stdout minimal;
    server_tokens off;
    underscores_in_headers off;
    ignore_invalid_headers on;
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 5s;

    upstream frontend {
        zone frontend 64k;
        server dspace-angular:4000 resolve;
        keepalive 16;
    }
    upstream backend {
        zone backend 64k;
        server dspace:8080 resolve;
        keepalive 16;
    }

{% if clarin_dspace_anubis_enabled | default(false) | bool %}
    upstream anubis {
        zone anubis 64k;
        server anubis:8923 resolve;
        keepalive 8;
    }
{% endif %}

{% if clarin_auth_enabled | default(false) | bool %}
    upstream shibboleth {
        zone shibboleth 64k;
        server shibboleth:8080 resolve;
    }
{% if clarin_auth_test_idp | default(false) | bool %}
    upstream test_idp {
        zone test_idp 64k;
        server test-idp:8081 resolve;
    }
{% endif %}
    # Raw query values are encoded once by the native frontend. Accept only our
    # complete HTTPS origin and UI path, not hostname-only backend validation.
    map $arg_redirectUrl $auth_return_allowed {
        default 0;
        "" 1;
        ~*^{{ (clarin_public_origin + clarin_ui_prefix) | regex_escape }}(?:/|\?|$) 1;
        ~*^{{ ((clarin_public_origin + clarin_ui_prefix) | urlencode | replace('/', '%2F')) | regex_escape }}(?:%2F|%3F|$) 1;
    }
{% endif %}
    # Stream transfers; do not spool repository content to the proxy filesystem.
    proxy_http_version 1.1;
{% if clarin_development | default(false) | bool %}
    map $http_upgrade $connection_upgrade {
        default upgrade;
        "" close;
    }
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
{% else %}
    proxy_set_header Connection "";
{% endif %}
    proxy_set_header Host {{ clarin_public_authority | default('repository.clarin.test') }};
    # Do not propagate client-supplied identity/proxy headers.
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Host {{ clarin_public_authority | default('repository.clarin.test') }};
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port {{ clarin_public_port | default(443) }};
    proxy_set_header X-Real-IP "";
    proxy_set_header Remote-User "";
    proxy_set_header Shib-Session-ID "";
    proxy_set_header Shib-Identity-Provider "";
    proxy_set_header Shib-Application-ID "";
    proxy_set_header Shib-Authentication-Instant "";
    proxy_set_header Shib-Authentication-Method "";
    proxy_set_header Shib-AuthnContext-Class "";
    proxy_set_header eppn "";
    proxy_set_header persistent-id "";
    proxy_set_header targeted-id "";
    proxy_set_header mail "";
    proxy_set_header uid "";
    proxy_set_header givenName "";
    proxy_set_header sn "";
    proxy_set_header cn "";
    proxy_set_header entitlement "";
    proxy_set_header affiliation "";
    proxy_set_header unscoped-affiliation "";
    proxy_set_header verification-token "";
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_max_temp_file_size 0;
    proxy_connect_timeout 5s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_next_upstream off;
    client_max_body_size 0;
    client_body_timeout 300s;
    send_timeout 300s;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    # Ignore unknown hosts and reject client-supplied identity headers.
    map $http_host $known_host {
        default 0;
        {{ clarin_public_host | default('repository.clarin.test') }} 1;
        {{ clarin_public_host | default('repository.clarin.test') }}:80 1;
        {{ clarin_public_host | default('repository.clarin.test') }}:{{ clarin_public_port | default(443) }} 1;
    }
    map "$http_remote_user$http_shib_session_id$http_shib_identity_provider$http_shib_application_id$http_shib_authentication_instant$http_shib_authentication_method$http_shib_authncontext_class$http_eppn$http_persistent_id$http_targeted_id$http_mail$http_uid$http_givenname$http_sn$http_cn$http_entitlement$http_affiliation$http_unscoped_affiliation$http_verification_token" $identity_spoof {
        default 1;
        "" 0;
    }
    server {
        listen 8080 default_server;
        server_name {{ clarin_public_host | default('repository.clarin.test') }};
        if ($known_host = 0) { return 444; }
        return 308 {{ clarin_public_origin | default('https://repository.clarin.test') }}$request_uri;
    }
    server {
        listen {{ clarin_public_port | default(443) }} ssl default_server;
        server_name {{ clarin_public_host | default('repository.clarin.test') }};
        ssl_certificate /etc/nginx/tls.crt;
        ssl_certificate_key /etc/nginx/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        if ($known_host = 0) { return 444; }
        if ($identity_spoof = 1) { return 403; }
{% if clarin_auth_test_idp | default(false) | bool %}
        # Local synthetic identity UI only; the service has no external network.
        location ^~ /__test-idp/ {
            proxy_pass http://test_idp;
            client_max_body_size 64k;
        }
{% endif %}
{% if clarin_dspace_anubis_enabled | default(false) | bool %}
        # Tomcat path parameters must not bypass the normalized discovery match.
        if ($uri ~* "^{{ clarin_rest_prefix }}(?:/.*)?;") { return 400; }
        location = /_anubis_check {
            internal;
            proxy_pass http://anubis/.within.website/x/cmd/anubis/api/check;
            proxy_pass_request_headers off;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host {{ clarin_public_authority | default('repository.clarin.test') }};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header User-Agent $http_user_agent;
            proxy_set_header Accept-Language $http_accept_language;
            proxy_set_header Accept-Encoding $http_accept_encoding;
            proxy_connect_timeout 2s;
            proxy_read_timeout 10s;
        }
        location ^~ /.within.website/ {
            proxy_pass http://anubis;
            proxy_pass_request_headers off;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host {{ clarin_public_authority | default('repository.clarin.test') }};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header User-Agent $http_user_agent;
            proxy_set_header Accept-Language $http_accept_language;
            proxy_set_header Accept-Encoding $http_accept_encoding;
            proxy_connect_timeout 2s;
            proxy_read_timeout 10s;
        }
        location @anubis_challenge {
            proxy_pass http://anubis;
            proxy_pass_request_headers off;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host {{ clarin_public_authority | default('repository.clarin.test') }};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header User-Agent $http_user_agent;
            proxy_set_header Accept-Language $http_accept_language;
            proxy_set_header Accept-Encoding $http_accept_encoding;
            proxy_connect_timeout 2s;
            proxy_read_timeout 10s;
        }
        location @anubis_api_required {
            default_type application/json;
            add_header Cache-Control no-store always;
            return 403 '{"error":"Browser verification required. Reload the repository page and retry."}';
        }
        location ~* ^{{ clarin_rest_prefix }}/api/(discover|browse)(/|$) {
            auth_request /_anubis_check;
            error_page 401 = @anubis_api_required;
            proxy_pass http://backend;
        }
{% endif %}
{% if clarin_auth_enabled | default(false) | bool %}
        # Protocol handlers never receive an Anubis challenge or discarded POST.
        location ^~ /Shibboleth.sso/ {
            proxy_pass http://shibboleth;
            add_header Cache-Control "no-store" always;
            add_header Referrer-Policy "no-referrer" always;
        }
        location = {{ clarin_rest_prefix }}/api/authn/shibboleth {
            if ($auth_return_allowed = 0) { return 400; }
            proxy_pass http://shibboleth;
            add_header Cache-Control "no-store" always;
            add_header Referrer-Policy "no-referrer" always;
        }
{% endif %}
        # Only the exact SP-protected callback may reach this authentication filter.
        location ~* ^{{ clarin_rest_prefix }}/api/authn/shibboleth { return 404; }
        # Explicit browser-only compatibility routes; never replay legacy writes.
        location = / {
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            return 308 {{ clarin_public_origin | default('https://repository.clarin.test') }}{{ clarin_ui_prefix }}/$is_args$args;
        }
        location = {{ clarin_ui_prefix }} {
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            return 308 {{ clarin_public_origin | default('https://repository.clarin.test') }}{{ clarin_ui_prefix }}/$is_args$args;
        }
        location ~ ^{{ clarin_ui_prefix }}/xmlui/?$ {
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            return 308 {{ clarin_public_origin | default('https://repository.clarin.test') }}{{ clarin_ui_prefix }}/$is_args$args;
        }
        location = {{ clarin_ui_prefix }}/xmlui/login {
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            return 308 {{ clarin_public_origin | default('https://repository.clarin.test') }}{{ clarin_ui_prefix }}/login$is_args$args;
        }
        location ~ ^{{ clarin_ui_prefix }}/xmlui/handle/(?<legacy_handle>[A-Za-z0-9._~-]+/[A-Za-z0-9._~/-]+)$ {
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            return 308 {{ clarin_public_origin | default('https://repository.clarin.test') }}{{ clarin_ui_prefix }}/handle/$legacy_handle$is_args$args;
        }
        location {{ clarin_ui_prefix }}/xmlui/ { return 404; }
        location = {{ clarin_rest_prefix }} {
            proxy_pass http://backend;
        }
        location {{ clarin_rest_prefix }}/ {
            proxy_pass http://backend;
        }
        location {{ clarin_ui_prefix }}/ {
{% if clarin_dspace_anubis_enabled | default(false) | bool %}
            auth_request /_anubis_check;
            error_page 401 = @anubis_challenge;
{% endif %}
            proxy_pass http://frontend;
        }
        location / { return 404; }
    }
    server {
        listen 127.0.0.1:8081;
        access_log off;
        location = /healthz { return 200 'ok\n'; }
        location / { return 404; }
    }
}
